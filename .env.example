# Copy this file to .env and fill in your key. .env is never committed.
OPENCODE_API_KEY=

# Optional: pin a model from `npm run check-ai`'s list, e.g. glm-5.3
# OPENCODE_MODEL=

# Optional: model for "Help me decide" (default gpt-6-luna)
# OPENCODE_DECIDE_MODEL=

# Optional but recommended: free LTA DataMall AccountKey for official bus arrivals with
# crowding (request at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html).
# Needs uv and `npm run mcp:setup` once. Without it, arrivals come from arrivelah.
# LTA_ACCOUNT_KEY=

# Optional: free data.gov.sg key for higher weather API rate limits
# DATA_GOV_SG_API_KEY=
